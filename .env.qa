# Port overrides for the QA stack — run alongside the live stack with:
#   docker compose --env-file .env.qa -p wheresdat-qa up -d --build
#
# Live stack (default project name, no env file) keeps 8101/8102/8103/8300.
# `-p wheresdat-qa` gives this stack its own docker-compose project name,
# which automatically namespaces its volumes/network separately from
# live (wheresdat-qa_wheresdat-db, not wheresdat_wheresdat-db) — the two
# stacks share no data.
DATASTORE_PORT=8111
REGISTRATION_PORT=8112
LABEL_MAKER_PORT=8113
KANBAN_PORT=8310
