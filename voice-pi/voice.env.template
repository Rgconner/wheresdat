# Copy to voice.env and fill in. Loaded by config.py.

# registration's externally-exposed URL — NOT datastore directly.
# datastore is ClusterIP-only by design (confirmed via `kubectl get svc -n
# wheresdat`); registration is the LoadBalancer-exposed API layer that
# already proxies /containers/search straight through to it. This keeps
# the raw database, and even datastore's own API, off the shop network —
# only registration's already-existing, already-external surface is used.
API_URL=http://192.0.2.16:8102

# Wake word. openWakeWord ships several pretrained models (alexa, hey_jarvis,
# hey_mycroft, etc.) — there is no pretrained "wheresdat" model, so start with
# hey_jarvis (closest cadence) and swap once/if a custom model gets trained.
# See openWakeWord's docs for the (straightforward) custom training path.
WAKE_WORD_MODEL=hey_jarvis

# Local SQLite cache of searchable container fields, resynced from
# DATASTORE_URL on startup and on a timer. Answers queries even if the shop
# network to the cluster is down; falls back to a live query only when the
# cache comes back empty AND the network is reachable.
CACHE_DB_PATH=/home/rgcon/wheresdat-voice/cache.sqlite3
CACHE_RESYNC_SECONDS=300

# faster-whisper model size. "tiny" or "base" are the realistic choices on
# Pi4/5 CPU — anything bigger gets slow enough to hurt the hands-free feel.
# Start with "base" (better accuracy on part numbers/names); drop to "tiny"
# if latency is a problem on your specific Pi.
STT_MODEL_SIZE=base

# Piper TTS voice. en_US-lessac-medium is a solid general-purpose default;
# swap for any Piper voice you prefer.
TTS_VOICE=en_US-lessac-medium

# ALSA/sounddevice device indices — leave blank to use the system default,
# set explicitly if you're running a USB mic/speaker combo that isn't the
# Pi's default audio device. Run `python3 -m sounddevice` to list indices.
AUDIO_INPUT_DEVICE=
AUDIO_OUTPUT_DEVICE=

# Seconds of silence before the wake chime, so a Bluetooth headset's audio
# link has time to wake and the chime isn't swallowed. 0 for a wired
# speaker; raise toward 0.5 if the chime is still clipped.
OUTPUT_LEAD_IN_SECONDS=0.3
